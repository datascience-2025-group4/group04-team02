   "source": [
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mtick\n",
    "import seaborn as sns\n",
    "\n",
    "# Filter your dataframe\n",
    "df = sm.query(\"chain_type == 'heavy' and 20 < ab_resnum < 40\").copy()\n",
    "\n",
    "# Calculate percentage for each ab_res (per group of ab_res)\n",
    "df['percent'] = df.groupby('ab_res')['count'].transform(lambda x: 100 * x / x.sum())\n",
    "\n",
    "# Plot\n",
    "ax = sns.barplot(\n",
    "    data=df,\n",
    "    x=\"ab_res\",\n",
    "    y=\"percent\",\n",
    "    hue=\"stat\"\n",
    ")\n",
    "plt.title(\"H1\")\n",
    "plt.xticks(rotation=90)\n",
    "ax.yaxis.set_major_formatter(mtick.PercentFormatter(decimals=0))\n",
    "plt.ylabel(\"Percentage (%)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
