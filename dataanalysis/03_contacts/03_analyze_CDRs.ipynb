   "source": [
    "rcp = (acp\n",
    "       .groupby(['pdb_id', 'ab_chain','chain_type', 'ab_resnum', 'ab_icode', 'ab_resname'])\n",
    "       .agg(natomcontacts = ('ag_resnum', 'size'),\n",
    "            nrescontacts = ('ag_resnum', 'nunique')).reset_index())\n",
    "\n",
    "rcp[\"contact\"] = rcp[\"natomcontacts\"] > 0   # always > 0, as we only have rows with atom contacts in acp\n",
    "\n",
    "rcp.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6571475f",
   "metadata": {},
   "source": [
