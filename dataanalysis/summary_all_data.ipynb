   "source": [
    "import pandas as pd\n",
    "\n",
    "# load files \n",
    "df_human = pd.read_csv(\"../data cleanup/human_cdr_seq.tsv\", sep=\"\\t\")\n",
    "df_influenza = pd.read_csv(\"../data cleanup/influenza_cdr_seq.tsv\", sep=\"\\t\")\n",
    "df_sars = pd.read_csv(\"../data cleanup/sars_cov2_cdr_seq.tsv\", sep=\"\\t\")\n",
    "\n",
    "# add source\n",
    "df_human[\"source\"] = \"human\"\n",
    "df_influenza[\"source\"] = \"influenza\"\n",
    "df_sars[\"source\"] = \"sars_cov2\"\n",
    "\n",
    "# combine all data\n",
    "all_data = pd.concat([df_human, df_influenza, df_sars], ignore_index=True)\n",
    "\n",
    "# control\n",
    "print(\"conclusion:\", all_data.shape[0], \"rows,\", all_data.shape[1], \"columns\")\n",
    "print(\"column name:\", list(all_data.columns)[:10], \"...\")\n",
    "\n",
    "# save in a new df\n",
    "all_data.to_csv(\"all_data.tsv\", sep=\"\\t\", index=False)\n",
    "print(\"saved as: all_data.tsv\")\n"
   ]
  },
